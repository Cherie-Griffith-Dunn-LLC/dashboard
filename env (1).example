# Azure AD Authentication Configuration
# Get these values from Azure Portal → Azure Active Directory

# Your Azure AD Application (Client) ID
# Find in: Azure Portal → App registrations → Your app → Overview → Application (client) ID
REACT_APP_AZURE_CLIENT_ID=your-client-id-here

# Your Azure AD Tenant (Directory) ID
# Find in: Azure Portal → Azure Active Directory → Overview → Tenant ID
REACT_APP_AZURE_TENANT_ID=your-tenant-id-here

# Your Application Redirect URI
# This should match what you configured in Azure AD App Registration
# For production: https://app.cyproteck.com
# For local dev: http://localhost:3000
REACT_APP_REDIRECT_URI=https://app.cyproteck.com

# Optional: Enable GitHub Integration
# Set to 'true' if you've configured GitHub as an identity provider in Azure AD
REACT_APP_GITHUB_ENABLED=true

# Azure Subscription Details (for Sentinel and Defender APIs)
# Find in: Azure Portal → Subscriptions
REACT_APP_AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Sentinel Workspace Details (optional, for direct API access)
REACT_APP_SENTINEL_WORKSPACE_ID=your-workspace-id-here

# Defender Tenant Details (optional, for direct API access)
REACT_APP_DEFENDER_TENANT_ID=your-defender-tenant-id-here

# =============================================================================
# Connector Services API (/api) — Amazon Connect + PSA ticketing + Copilot
# These are Azure Functions App Settings (server-side), NOT React build vars.
# None are required to run in simulation mode. See api/README.md for details.
# =============================================================================

# Active authoritative PSA: helpdesk (default) | connectwise | halo | ninjaone
PSA_CONNECTOR=helpdesk

# Amazon Connect webhook auth (shared secret or HMAC key) — set in production
AMAZON_CONNECT_WEBHOOK_SECRET=

# Service API key for machine-to-machine callers (sent as x-api-key)
CONNECTOR_API_KEY=

# Local development only: disable auth on management endpoints
# ALLOW_ANONYMOUS_API=true

# Azure AI Foundry / Azure OpenAI for live Copilot (else heuristic fallback)
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=

# Duplicate-ticket detection tuning (defaults: 1440 minutes / 0.55 similarity)
# DEDUPE_WINDOW_MINS=1440
# DEDUPE_THRESHOLD=0.55

# --- ConnectWise Manage (when PSA_CONNECTOR=connectwise) ---
# CONNECTWISE_SITE=https://na.myconnectwise.net
# CONNECTWISE_COMPANY_ID=
# CONNECTWISE_PUBLIC_KEY=
# CONNECTWISE_PRIVATE_KEY=
# CONNECTWISE_CLIENT_ID=
# CONNECTWISE_BOARD=

# --- HaloPSA (when PSA_CONNECTOR=halo) ---
# HALO_BASE_URL=https://cyproteck.halopsa.com
# HALO_CLIENT_ID=
# HALO_CLIENT_SECRET=

# --- NinjaOne (when PSA_CONNECTOR=ninjaone) ---
# NINJAONE_BASE_URL=https://app.ninjarmm.com
# NINJAONE_CLIENT_ID=
# NINJAONE_CLIENT_SECRET=

# --- Amazon Connect standalone Cases/Tasks (optional) ---
# AWS_REGION=us-east-1
# AMAZON_CONNECT_INSTANCE_ID=
# AMAZON_CONNECT_DOMAIN_ID=
# AMAZON_CONNECT_CASE_TEMPLATE_ID=
# AMAZON_CONNECT_TASK_FLOW_ID=

# =============================================================================
# Healthcare Visibility + Foundry: environment, connectors, risk, compliance
# =============================================================================

# Environment: dev | test | prod (stamped on audit records, drives guard rails)
APP_ENV=dev

# Enable optional CMMC readiness alongside HIPAA
# ENABLE_CMMC=true

# Override risk category weights (JSON)
# RISK_WEIGHTS_JSON={"ehr":0.25,"identity":0.2}

# Suppress audit stdout sink (used by tests); leave unset in real environments
# AUDIT_SILENT=true

# Durable audit sink (Azure SQL); when unset, audit is retained in-memory (DEV/TEST)
# AUDIT_SQL_CONNECTION=

# --- Microsoft 365 / Entra ID connector ---
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- SentinelOne (EDR) connector ---
# SENTINELONE_BASE_URL=https://usea1.sentinelone.net
# SENTINELONE_API_TOKEN=

# --- Epic (EHR) connector — see EPIC_APPROVAL_GUIDE.md (indicators only, no PHI) ---
# EPIC_BASE_URL=
# EPIC_CLIENT_ID=
# EPIC_PRIVATE_KEY=

# --- Network connector (scanner/firewall) ---
# NETWORK_SCANNER_URL=
# NETWORK_API_KEY=

# --- Azure / Defender for Cloud connector (server-side; distinct from REACT_APP_*) ---
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- AWS connector (Security Hub / GuardDuty) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ROLE_ARN=
